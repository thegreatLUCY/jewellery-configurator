¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~¢¢¢~